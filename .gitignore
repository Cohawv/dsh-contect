# 依赖
node_modules/

# Go 构建产物
*.exe

# 打包产物（dsh/dist/ 必须提交：从 git 安装不执行 build 脚本）
*.tgz

# 日志与临时文件
*.log
*.txt

# 备份快照（可回滚产物，不进版本库）
backup/

# 本地运行产物
bin/

# 压测归档（scripts/bench-baseline.sh 的产出；数字与机器强相关，不入库）
/bench/

# 根构建/运行态目录（Go hub 的 exe 由 *.exe 已忽略，这里补忽略运行态 hub.json/log 与发布目录）
/dist/
# 更新通道真实发布目录（由发布脚本写入，非源码，勿入库）
/updates/

# AI 会话数据（非项目源码）
.workbuddy/

# ---- 本仓库只发布源码，以下内容不入库（文件保留在本地磁盘）----
# 工作过程记录（AI 会话日志）
/实施记录.md
# 过程性文档（方案/规划/审计）
/docs/
# 测试套件（dsh 前端 sim；Go 契约与集成测试）
# 注：test/plugincontract/ 是断言库，被 scripts/new-plugin.sh 生成的模板 import，必须入库
/dsh/test/
/test/contract/
/test/integration/
/test/pluginidem/
# 一次性排障脚本
/scripts/adb-audit.sh
/scripts/adb-audit2.sh
