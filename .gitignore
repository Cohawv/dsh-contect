# 依赖
node_modules/

# Go 构建产物
*.exe

# 打包产物（dsh/dist/ 必须提交：从 git 安装不执行 build 脚本）
*.tgz

# 日志与临时文件
*.log
*.txt

# 备份快照（可回滚产物，不进版本库）
backup/

# 本地运行产物
bin/

# 压测归档（scripts/bench-baseline.sh 的产出；数字与机器强相关，不入库）
/bench/

# 根构建/运行态目录（Go hub 的 exe 由 *.exe 已忽略，这里补忽略运行态 hub.json/log 与发布目录）
/dist/
# 更新通道真实发布目录（由发布脚本写入，非源码，勿入库）
/updates/

# AI 会话数据（非项目源码）
.workbuddy/
